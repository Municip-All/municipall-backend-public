# --- Application Configuration ---
NODE_ENV=development
PORT=3000

# --- Database (PostGIS) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=municipall

# --- Cache & Queues (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Authentication ---
JWT_SECRET=change-me-in-production

# Clé plateforme (webadmin Municipall → routes /admin). Même valeur que NEXT_PUBLIC_PLATFORM_ADMIN_KEY.
PLATFORM_ADMIN_KEY=

# --- AI Integrations ---
OPENAI_API_KEY=

# URL du service IA Python (FastAPI). Default: http://localhost:8000
IA_BASE_URL=http://localhost:8000

# --- Transports IDFM / PRIM (Île-de-France Mobilités) ---
# Jeton API : https://prim.iledefrance-mobilites.fr → Mes jetons d'authentification
# Envoyé dans l'en-tête HTTP « apiKey » (voir doc PRIM).
IDFM_API_KEY=

# --- Météo (OpenWeatherMap) ---
# Clé gratuite : https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# --- Notifications push (Expo) ---
# Les alertes backoffice utilisent https://exp.host (aucune clé requise pour Expo Push).
# L'app mobile enregistre un ExponentPushToken via POST /users/push-token.

# --- CORS ---
# Origins séparées par des virgules. Laisser * pour dev.
CORS_ORIGINS=*
